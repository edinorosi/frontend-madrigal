{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "edinoros",
  "version": "../package.json",
  "identifier": "lab.protocol.edinoros",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:8080 npm run dev",
    "beforeBuildCommand": "cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:8080 npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Лаборатория протоколов",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../backend/fixtures": "fixtures"
    },
    "externalBin": ["binaries/protocol-lab-api"]
  }
}
