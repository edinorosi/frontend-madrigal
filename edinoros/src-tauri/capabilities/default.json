{
  "identifier": "default",
  "description": "Базовые возможности: окно открывается, сеть ходит обычным fetch (sidecar бека на localhost).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "mcp-bridge:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
